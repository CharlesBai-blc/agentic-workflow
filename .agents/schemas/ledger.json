{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents/schemas/ledger.json",
  "title": "Fleet Task Ledger",
  "description": "Schema for .agents/ledger.json. Written ONLY by set_status (scripts/lib/ledger.sh) and the layer helpers; Tier 1 initializes it, Tier 2 appends tasks, orchestrate.sh drives transitions. Validated with check-jsonschema on every write.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "created_at", "updated_at", "current_layer", "layers", "tasks", "quota", "incidents"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "current_layer": { "type": "integer", "minimum": 0 },
    "run_state": {
      "type": "string",
      "enum": ["IDLE", "RUNNING", "PAUSED_QUOTA", "HALTED", "COMPLETE"],
      "default": "IDLE"
    },
    "halt_reason": { "type": ["string", "null"], "maxLength": 600 },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "title", "status", "base_tag", "waves"],
        "properties": {
          "layer": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "maxLength": 200 },
          "status": {
            "type": "string",
            "enum": ["PLANNED", "FROZEN", "SLICED", "CODING", "SIGNOFF", "REWORK", "SIGNED_OFF", "CLOSED"]
          },
          "base_tag": { "type": ["string", "null"], "pattern": "^layer-[0-9]+-base$" },
          "base_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "frozen_at": { "type": ["string", "null"], "format": "date-time" },
          "signed_off_at": { "type": ["string", "null"], "format": "date-time" },
          "surgery_failures": { "type": "integer", "minimum": 0, "default": 0 },
          "rework_rounds": { "type": "integer", "minimum": 0, "default": 0 },
          "waves": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string", "pattern": "^TASK-[0-9]{3}-[0-9]{3}$" }
            },
            "description": "Ordered waves; each wave lists task IDs that may run in parallel (disjoint OWNED_FILES)."
          },
          "signoff_file": { "type": ["string", "null"] },
          "diagram_file": { "type": ["string", "null"] },
          "report_file": { "type": ["string", "null"] }
        }
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": { "pattern": "^TASK-[0-9]{3}-[0-9]{3}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "wave", "title", "status", "risk", "file", "owned_files", "readonly_files", "approved_deps", "strikes", "reviews", "history"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-[0-9]{3}-[0-9]{3}$" },
          "layer": { "type": "integer", "minimum": 0 },
          "wave": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "maxLength": 200 },
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "GATE_FAILED", "IN_REVIEW", "MERGED", "CONTRACT_DEFECT", "STRIKE_3_FAILED", "QUARANTINED", "IN_SURGERY"]
          },
          "risk": { "type": "string", "enum": ["low", "high"] },
          "kind": { "type": "string", "enum": ["feature", "rework", "fix"], "default": "feature" },
          "file": { "type": "string", "pattern": "^\\.agents/tasks/TASK-[0-9]{3}-[0-9]{3}\\.md$" },
          "owned_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "readonly_files": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
          "approved_deps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3}-[0-9]{3}$" } },
          "branch": { "type": ["string", "null"], "pattern": "^agent/TASK-[0-9]{3}-[0-9]{3}$" },
          "worktree": { "type": ["string", "null"] },
          "strikes": { "type": "integer", "minimum": 0, "maximum": 3 },
          "gate_failures": { "type": "integer", "minimum": 0, "default": 0 },
          "reviews": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "verdict", "file"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "verdict": { "type": "string", "enum": ["APPROVE", "REJECT"] },
                "file": { "type": "string" },
                "effort": { "type": "string", "enum": ["medium", "high"] }
              }
            }
          },
          "receipt": { "type": ["string", "null"], "description": "Path of the last receipt, e.g. .agents/receipts/TASK-001-003.json (gitignored)." },
          "receipt_status": { "type": ["string", "null"], "enum": ["DONE", "CONTRACT_DEFECT", "ESCALATE_STRIKE_3", null] },
          "defect_location": { "type": ["string", "null"] },
          "root_cause": { "type": ["string", "null"], "maxLength": 600 },
          "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "merge_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "pr_url": { "type": ["string", "null"], "format": "uri" },
          "pr_number": { "type": ["integer", "null"], "minimum": 1 },
          "fail_file": { "type": ["string", "null"] },
          "surgery_count": { "type": "integer", "minimum": 0, "default": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "from", "to", "by"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "from": { "type": ["string", "null"] },
                "to": { "type": "string" },
                "by": { "type": "string", "enum": ["tier1", "tier2-phaseA", "tier2-phaseB", "tier2-surgery", "orchestrate", "gate", "tripwire", "review", "merge", "quota", "timeout"] },
                "note": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/quotaWindow" },
        "claude": { "$ref": "#/$defs/quotaWindow" }
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "kind", "layer", "detail"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "kind": {
            "type": "string",
            "enum": ["STRIKE_3", "CONTRACT_DEFECT", "QUARANTINED", "GATE_FAILED", "REVIEW_REJECT", "SURGERY_START", "SURGERY_DONE", "SURGERY_FAILED", "SURGERY_BREAKER", "QUOTA_PAUSE", "QUOTA_RESUME", "TIMEOUT", "REVERT", "HALT"]
          },
          "layer": { "type": "integer", "minimum": 0 },
          "task": { "type": ["string", "null"], "pattern": "^TASK-[0-9]{3}-[0-9]{3}$" },
          "detail": { "type": "string", "maxLength": 600 }
        }
      }
    }
  },
  "$defs": {
    "quotaWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["five_hour_pct", "weekly_pct", "resets_at", "checked_at", "source"],
      "properties": {
        "five_hour_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "weekly_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "resets_at": { "type": ["string", "null"], "format": "date-time" },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "source": { "type": "string", "enum": ["rollout-log", "rate_limit_event", "ccusage", "none"] },
        "state": { "type": "string", "enum": ["OK", "WARNING", "REJECTED", "UNKNOWN"], "default": "UNKNOWN" }
      }
    }
  }
}
